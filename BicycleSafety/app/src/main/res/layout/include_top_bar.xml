<?xml version="1.0" encoding="utf-8"?>
<!-- 상단 바: 경로 설정 + 음성 알림 + 설정 버튼 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <!-- 경로 설정 버튼 -->
    <LinearLayout
        android:id="@+id/btn_route_setting"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_small"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_panel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="경로 설정"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 버튼 사이의 빈 공간 -->
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 음성 알림 버튼 -->
    <LinearLayout
        android:id="@+id/btn_voice_toggle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_chip"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_volume" />

        <TextView
            android:id="@+id/tv_voice_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="음성 알림 켜짐"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 설정 버튼: 음성 알림 버튼과 별도로 배치 -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_button_small"
        android:contentDescription="설정"
        android:padding="9dp"
        android:src="@android:drawable/ic_menu_preferences"
        app:tint="@color/text_primary" />

</LinearLayout>
