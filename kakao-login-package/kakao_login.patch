+package com.example.bicyclesafety;
+
+import android.app.Application;
+
+import com.kakao.sdk.common.KakaoSdk;
+import com.kakao.vectormap.KakaoMapSdk;
+
+public class MapApplication extends Application {
+
+    // 카카오 디벨로퍼스 네이티브 앱 키 (카카오맵과 카카오 로그인이 같은 키를 사용)
+    // 바꿀 때는 AndroidManifest.xml 의 android:scheme="kakao{키}" 도 함께 바꿔야 합니다.
+    public static final String KAKAO_NATIVE_APP_KEY = "18be7798c2d03fdfca0069f1e368b817";
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+
+        // 카카오맵 SDK 초기화
+        KakaoMapSdk.init(this, KAKAO_NATIVE_APP_KEY);
+
+        // 카카오 로그인 SDK 초기화
+        KakaoSdk.init(this, KAKAO_NATIVE_APP_KEY);
+    }
+}
